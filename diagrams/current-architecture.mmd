---
config:
  theme: neutral
  flowchart:
    nodeSpacing: 50
    rankSpacing: 60
---
flowchart TB
    %% ============ HOST ============
    subgraph HOST["Host machine"]
        direction TB
        user(["User"])
        media[/"input media file<br/>(audio or video)"/]

        subgraph WRAPPERS["Wrapper scripts (one docker run each)"]
            direction LR
            subgraph TX["transcribex"]
                tx1["args: -o --output, -m --model,<br/>-q --quiet<br/>tag: :small / :medium / :large-v3"]
            end
            subgraph SX["subtitlex"]
                sx1["args: -o --output, -b --bake,<br/>-m --model<br/>tag: :small / :medium / :large-v3"]
            end
        end

        pipe[["cat FILE | docker run --rm -i :tag<br/>media piped to container STDIN"]]
    end

    %% ============ CONTAINER ============
    subgraph IMAGE["Docker container: gencore/whisperx-speech-to-text :tag"]
        direction TB
        subgraph EP["entrypoint.sh"]
            direction TB
            stdin_read["read STDIN into /tmp/stdin_input"]
            ffmpeg1["ffmpeg: 16 kHz mono WAV + dynaudnorm"]
            mode{"--output flag?"}
            tx_whisper["TRANSCRIPT MODE: whisperx --no_align<br/>--output_format txt --language en<br/>--compute_type int8"]
            sub_whisper["VIDEO MODE: whisperx with alignment pass<br/>--output_format srt --language en"]
            ffmpeg2["ffmpeg: mux SRT as mov_text track,<br/>or --bake: burn subtitles into video"]
        end
    end

    %% ============ OUTPUT ============
    stdout[["STDOUT: transcript (.txt), or MP4<br/>with soft / burned-in subtitles"]]

    %% ============ BUILD TIME ============
    subgraph BUILD["Built once at docker build time"]
        direction TB
        hf["HuggingFace Hub:<br/>Whisper + alignment models"]
        deps["python:3.11-slim, ffmpeg,<br/>torch 2.3.1+cpu,<br/>whisperx (--no-deps),<br/>pyannote-audio (installed, unused)"]
        precache["pre-cached Whisper +<br/>alignment models (jfk.wav step)"]
        modelsize["/etc/model_size"]
    end

    %% ============ FLOWS ============
    user --> tx1
    user --> sx1
    user --> media
    media --> pipe
    tx1 --> pipe
    sx1 --> pipe
    pipe -->|"STDIN"| stdin_read
    stdin_read --> ffmpeg1 --> mode
    mode -->|"no"| tx_whisper
    mode -->|"yes"| sub_whisper --> ffmpeg2
    tx_whisper --> stdout
    ffmpeg2 --> stdout
    tx_whisper -.->|"uses"| precache
    sub_whisper -.->|"uses"| precache
    tx_whisper -.->|"reads"| modelsize
    hf --> deps
    deps --> precache
    deps --> modelsize
